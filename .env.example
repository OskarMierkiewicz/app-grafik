# skopiuj do .env i zmień hasła
POSTGRES_USER=grafik
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=grafik
# adres, na którym nasłuchuje aplikacja: 0.0.0.0 = z internetu (port 8000), 127.0.0.1 = tylko z serwera (tunel SSH)
# WEB_BIND=0.0.0.0
# nazwa w nagłówku i na karcie przeglądarki (opcjonalnie)
# APP_NAME=Grafik - Lux Med Wileńska 44
# konto administratora (panel admina, użytkownicy, generowanie grafiku)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=Haslo-admina-zmien-mnie
# klucz podpisu sesji (ciasteczek logowania): długi losowy ciąg, np. wynik `openssl rand -hex 32`.
# Puste = losowy przy każdym starcie (wszyscy wylogowani po restarcie)
SECRET_KEY=
# ustaw 1, gdy aplikacja stoi za HTTPS (ciasteczka tylko przez HTTPS)
SESSION_HTTPS_ONLY=0
# do którego dnia miesiąca poprzedzającego można składać dyspozycje (11. dnia blokada)
SUBMISSION_DEADLINE_DAY=10
TZ_NAME=Europe/Warsaw
# limit ustawowy łącznego czasu pracy (1 = włączony, 0 = wyłączony), patrz README
LAW_ENABLED=1
LAW_EFFECTIVE_FROM=2027-01
LAW_TOTAL_MAX_H=320
